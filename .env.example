# ---------------------------------------------------------------------------
# Copy this file to .env and edit if you need to. Every value below is
# already the default, so an empty or absent .env works fine.
# ---------------------------------------------------------------------------

# --- database ---------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=oilspill

# --- service ports ----------------------------------------------------------
GATEWAY_PORT=4000
DETECTION_PORT=8001
BACKTRACK_PORT=8002
AIS_PORT=8003

# --- where the gateway finds the Python services ----------------------------
DETECTION_URL=http://127.0.0.1:8001
BACKTRACK_URL=http://127.0.0.1:8002
AIS_URL=http://127.0.0.1:8003

# --- ocean current data -----------------------------------------------------
# Open-Meteo's Marine API is free and needs NO key. Leave OPENMETEO_API_KEY
# blank unless you have bought a commercial plan -- setting it switches the
# request to Open-Meteo's paid host, which will reject a free-tier request.
#
# The endpoint itself is not a secret and is not configured here; it lives in
# shared_apis/drift_forcing_client.py:
#   https://marine-api.open-meteo.com/v1/marine
OPENMETEO_API_KEY=

# How many points across to sample the current field. 4 means a 4x4 grid in
# one batched request. Two or more is required for the drift ensemble to have
# any spatial gradient to work with; 1 would flatten the posterior.
OPENMETEO_GRID_SIDE=4

# Degrees of padding around the slick when requesting current data. Must
# comfortably cover a 48-hour drift: about 0.5 degrees at typical Gulf speeds.
CURRENT_BBOX_PADDING_DEG=0.8

# Optional local CMEMS NetCDF cache. If set and readable it takes priority
# over the API. Leave blank to use Open-Meteo.
CURRENT_CACHE_PATH=

# --- model / scoring tuning -------------------------------------------------
DETECT_THRESHOLD=0.5
RELEASE_FOOTPRINT_FRAC=1.0
AIS_PROXIMITY_WEIGHT=0.7
